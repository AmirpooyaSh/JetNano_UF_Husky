<?xml version="1.0"?>
<launch>
  <!-- Mapless: no map_server, no AMCL. move_base plans in the odom frame
       using the EKF (wheels + UM7) odometry. -->

  <arg name="obstacle_range" default="24.0"/>
  <arg name="raytrace_range" default="25.0"/>

  <param name="/move_base/DWAPlannerROS/odom_topic" value="/odometry/filtered"/>


  <!-- Zero gyro + reset odom to (0,0,0) at launch. Robot must be still on the start mark. -->
  <node pkg="robot_bringup" type="reset_odom_on_start.py" name="reset_odom_on_start" output="screen"/>

  <!-- Move Base without a static map (global costmap in odom). Only its velocity output is remapped. -->
  <group>
    <remap from="/cmd_vel" to="/cmd_vel_nav"/>
    <include file="$(find husky_navigation)/launch/move_base.launch">
      <arg name="no_static_map" value="true"/>
    </include>
  </group>

  <!-- No recovery rotations; after an e-brake pause move_base simply continues the same goal -->
  <param name="/move_base/recovery_behavior_enabled" value="false"/>
  <param name="/move_base/clearing_rotation_allowed" value="false"/>

  <param name="/move_base/DWAPlannerROS/max_vel_x" value="1.0"/>
  <param name="/move_base/DWAPlannerROS/max_vel_trans" value="1.0"/>
  <param name="/move_base/DWAPlannerROS/max_vel_theta" value="2.0"/>

  <!-- This is to reduce the obstacle Offset -->
  <param name="/move_base/global_costmap/inflation/inflation_radius" value="0.05"/>
  <param name="/move_base/local_costmap/inflation/inflation_radius" value="0.05"/>

  <param name="/move_base/local_costmap/obstacles_laser/obstacle_range" value="4.0"/>
  <param name="/move_base/local_costmap/obstacles_laser/raytrace_range" value="4.5"/>
  <param name="/move_base/local_costmap/width"  value="10"/>
  <param name="/move_base/local_costmap/height" value="10"/>

</launch>