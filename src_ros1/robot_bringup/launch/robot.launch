<?xml version="1.0"?>

<launch>
    <!-- =========================================================
         Configurable arguments
         ========================================================= -->

    <arg name="enable_lidar" default="true" />
    <arg name="enable_gesture_bridge" default="true" />

    <!-- Husky serial port:
         Uses HUSKY_PORT when set, otherwise /dev/prolific -->
    <arg name="port" default="$(optenv HUSKY_PORT /dev/prolific)" />

    <!-- SICK LMS1xx IP address -->
    <arg name="lidar_hostname" default="192.168.131.20" />
    <!-- SICK LMS1xx Parental Frame -->
    <arg name="tf_base_frame_id" default="base_link" />
    <!-- SICK LMS1xx Transform -->
    <arg name="add_transform_xyz_rpy" default="0,0,0,0,0,0" />

     <arg name="lidar_topic"
          default="$(optenv HUSKY_LMS1XX_TOPIC front/scan)" />

    <!-- =========================================================
         Husky hardware driver
         ========================================================= -->

    <node pkg="husky_base"
          type="husky_node"
          name="husky_node"
          output="screen">

        <rosparam subst_value="true">
            port: $(arg port)

            control_frequency: 10.0
            diagnostic_frequency: 1.0

            max_acceleration: 3.0
            max_speed: 1.0
            wheel_diameter: 0.3302
            polling_timeout: 10.0
        </rosparam>
    </node>


    <!-- =========================================================
         Husky control, localization, and teleoperation
         ========================================================= -->

    <include file="$(find husky_control)/launch/control.launch" />

    <include file="$(find husky_control)/launch/teleop.launch" />


    <!-- =========================================================
         Husky diagnostics
         ========================================================= -->

    <node pkg="diagnostic_aggregator"
          type="aggregator_node"
          name="diagnostic_aggregator"
          output="screen">

        <rosparam command="load"
                  file="$(find husky_base)/config/diagnostics.yaml" />
    </node>


    <!-- =========================================================
         SICK LMS1xx LiDAR
         ========================================================= -->

     <group if="$(arg enable_lidar)">
     <include file="$(find sick_scan_xd)/launch/sick_lms_1xx.launch">
          <arg name="hostname" value="$(arg lidar_hostname)" />

          <!-- Husky navigation expects /front/scan -->
          <arg name="laserscan_topic" value="$(arg lidar_topic)" />

          <!-- Matches the Husky URDF -->
          <arg name="frame_id" value="front_laser" />

          <!-- URDF owns base_link -> front_laser -->
          <arg name="tf_publish_rate" value="0.0" />
     </include>
     </group>


    <!-- =========================================================
         ROS2 -> ROS1 hand gesture ZeroMQ bridge
         ========================================================= -->

    <group if="$(arg enable_gesture_bridge)">
        <include file="$(find hand_gesture_bridge)/launch/gesture_receiver.launch" />
    </group>

</launch>