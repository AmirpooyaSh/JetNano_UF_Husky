<?xml version="1.0"?>
<package format="2">
  <name>voice_classifier</name>
  <version>0.1.0</version>
  <description>Continuous microphone transcription with WhisperLive and voice-command classification with Ollama.</description>

  <maintainer email="apshirazi.private@gmail.com">Amirpooya Shirazi</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-pyaudio</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-websocket</exec_depend>
</package>
